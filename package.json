{
  "name": "lun-art",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "volta": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/space-mono": "^5.3.0",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.3.5",
    "astro-portabletext": "^1.0.1",
    "posthog-js": "^1.435.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sanity/vision": "^6.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "groq-js": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.17.0",
    "sanity-plugin-asset-source-unsplash": "^7.0.26",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "core-js": false
  }
}
