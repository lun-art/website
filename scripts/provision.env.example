# Copy to provision.env (gitignored) and fill in. See SETUP.md, "Provisioning".

# The client
CLIENT_SLUG=lun-art                # Worker name and Studio host
SITE_NAME="Arch Lunar Art Archive"
SITE_URL=https://lun.art          # Production URL, no trailing slash
GITHUB_REPO=lun-art/website

# Cloudflare (free plan is enough): a user-scoped API token with Workers
# Scripts Edit, Workers Builds Configuration Edit and Account Settings Read.
# Wrangler uses it too while this file is loaded.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_AUTH_TOKEN=                 # personal token (sanity debug --secrets)

# Optional: CMS-publish e2e test in CI, against a non-production dataset
E2E_SANITY_DATASET=e2e
E2E_SANITY_WRITE_TOKEN=            # Editor token for the project

# Launch only (`./scripts/provision.sh email`)
RESEND_API_KEY=
RESEND_FROM=                       # e.g. "Client <hello@client.example>"
CONTACT_NOTIFY_EMAIL=
RESEND_SEGMENT_ID=                 # the Resend segment newsletter sign-ups join
