---
import ContactForm from "@/components/ContactForm.astro";
import { localeStaticPaths, t, type Locale } from "@/i18n";
import Base from "@/layouts/Base.astro";

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
---

<Base
  locale={locale}
  path="/contact"
  title={t(locale, "contact.title")}
  description={t(locale, "contact.description")}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold">{t(locale, "contact.title")}</h1>
    <p class="text-muted mt-3">{t(locale, "contact.description")}</p>
    <ContactForm locale={locale} />
  </div>
</Base>
