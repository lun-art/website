# Copy to .env for `astro dev`. Use a non-production Sanity dataset locally.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=development
# Analytics stays off locally: leave the PostHog key empty.
PUBLIC_POSTHOG_KEY=
# Tag Manager stays off locally too.
PUBLIC_GTM_ID=
