# Public build-time values (Workers Builds and local `astro build`). Inlined
# into pages, so nothing here is secret. scripts/provision.sh fills them in.
PUBLIC_SITE_URL=https://lun.art
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Analytics: PostHog (EU cloud), cookieless. Leave the key empty to turn it off.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Google Tag Manager, kept from the original site. Sets cookies. Empty = off.
PUBLIC_GTM_ID=GTM-PK2ML5FB
