---
import Prose from "@/components/Prose.astro";
import { localeStaticPaths, t, type Locale } from "@/i18n";
import Base from "@/layouts/Base.astro";
import { pageBySlugQuery, sanityFetch, type Page } from "@/lib/sanity";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const page = await sanityFetch<Page>(pageBySlugQuery, { slug: "home" });
---

<Base
  locale={locale}
  path="/"
  description={page?.seoDescription}
  image={page?.seoImage}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    {page ? (
      <>
        <h1 class="font-display text-4xl font-semibold">{page.title}</h1>
        {page.body && (
          <div class="mt-8">
            <Prose value={page.body} />
          </div>
        )}
      </>
    ) : (
      <>
        <h1 class="text-3xl font-semibold">{t(locale, "home.emptyTitle")}</h1>
        <p class="text-muted mt-4">{t(locale, "home.emptyBody")}</p>
      </>
    )}
  </div>
</Base>
